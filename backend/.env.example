# backend / registry. Set the top four; the rest have code defaults.
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/raven?retryWrites=true&w=majority
PLATFORM_PAYTO=
PLATFORM_PRIVATE_KEY=            # the payout wallet's SECRET key: base58 (wallet export) or a
                                 # solana-keygen JSON array of 64 numbers. NOT hex — base58 has no '0'
                                 # — and not a 32-byte key; both fail and every payout lands unpaid.
SESSION_SECRET=                 # 32+ random bytes (openssl rand -hex 32). These JWTs authorize
                                 # spending a user's balance, so a guessable secret = stolen funds.
MAINNET=false                   # true = mainnet-beta, false = devnet

# Private tunnel relay (the `bore` compose service). Every lease's SSH port is published through it,
# so buyer traffic never transits the public bore.pub. The registry hands both values to each daemon
# over its authenticated register call — contributors configure nothing.
# Point BORE_SERVER at the PUBLIC hostname/IP of this machine (contributors and buyers must reach it):
# its control port 7835 and the 20000-20100 tunnel range have to be open to the internet.
# Leave BORE_SERVER unset to fall back to public bore.pub — fine for a demo, not for real traffic.
BORE_SERVER=                    # e.g. tunnel.raven.example  (no scheme, no port)
BORE_SECRET=                    # random 32+ byte string; gates who may open a tunnel on your relay

# Optional overrides (defaults shown)
# PORT=4000
# REQUIRE_SSH_KEY=false           # false = keyless leases, root password IS the buyer's wallet address
#                                 # (public, so a live lease is reachable by anyone who knows it).
#                                 # true = demand a buyer-supplied public key, no password auth.
# MAX_LEASE_TTL_S=86400           # guest self-destruct cap (seconds)
# MONGODB_DB=raven               # database name (also settable in the URI path)
# METER_INTERVAL_MS=10000        # watchdog tick; worst-case over-use is one tick
# SOLANA_RPC_URL=...             # overrides the MAINNET cluster RPC; WS derived from it
# SOLANA_WS_URL=...
# DEPOSIT_CONFIRM_TIMEOUT_MS=30000  # how long /wallet/topup waits for a deposit to confirm
# DEPOSIT_CONFIRM_POLL_MS=1500      # poll interval while waiting
