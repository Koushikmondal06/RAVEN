# contributor daemon. No wallet, no payout address on this box.
RAVEN_KEY=                      # from the "Contribute" page after wallet sign-in
REGISTRY_URL=http://localhost:4000

# Isolation tier. firecracker (microvm) is the only tier the marketplace rents — each lease boots its
# own guest kernel under KVM. Run scripts/setup-firecracker.sh once on the host first.
# 'docker' is a local-dev backend only: shared host kernel, shows "Below min", cannot be rented.
SANDBOX_BACKEND=firecracker      # firecracker (microvm) | docker (container, dev only)

# firecracker paths (defaults shown; setup-firecracker.sh creates all of these)
# FC_KERNEL=/var/lib/raven/vmlinux    # uncompressed guest kernel
# FC_CACHE_DIR=/var/lib/raven/rootfs  # cached ext4 rootfs, keyed by image digest
# FC_STATE=/var/lib/raven             # per-lease network slots live in $FC_STATE/slots
# FC_CHROOT=/srv/jailer               # jailer chroot base
# FC_DNS=1.1.1.1                      # resolver written into each guest's /etc/resolv.conf

# Optional overrides (defaults shown)
# EGRESS_MODE=allowlist           # allowlist | deny-all | open. Per-lease nftables on the guest's tap
# REAP_INTERVAL_MS=60000          # orphan-sandbox reaper period
# KILL_PORT=4999                  # local-only kill switch: POST http://127.0.0.1:KILL_PORT/kill
# RATE_LAMPORTS_PER_HOUR=50000000 # 0.05 SOL/hour
# NODE_LABEL=                     # defaults to hostname
# SHARE_CPUS=                     # defaults to cores-1
# SHARE_MEM_MB=                   # defaults to half of RAM
# TUNNEL_MODE=bore                # bore = outbound tunnel, no inbound ports; local = same-LAN SSH
# BORE_SERVER=bore.pub
