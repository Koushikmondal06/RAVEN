# contributor daemon. Only these two are required — no wallet, no payout address on this box.
RAVEN_KEY=                      # from the "Become a Contributor" page after wallet sign-in
REGISTRY_URL=http://localhost:4000

# Optional overrides (defaults shown)
# SANDBOX_BACKEND=docker          # docker (container) · gvisor (usermode-kernel) · kata-fc / firecracker (microvm)
# EGRESS_MODE=allowlist           # allowlist | deny-all | open. Enforced on tap-based backends (firecracker)
# REAP_INTERVAL_MS=60000          # orphan-sandbox reaper period
# KILL_PORT=4999                  # local-only kill switch: POST http://127.0.0.1:KILL_PORT/kill
# RATE_LAMPORTS_PER_HOUR=50000000 # 0.05 SOL/hour
# NODE_LABEL=                     # defaults to hostname
# SHARE_CPUS=                     # defaults to cores-1
# SHARE_MEM_MB=                   # defaults to half of RAM
# TUNNEL_MODE=bore                # bore = outbound tunnel, no inbound ports; local = same-LAN SSH
# BORE_SERVER=bore.pub
