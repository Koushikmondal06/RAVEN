# Run the contributor daemon natively (NOT inside a container with the Docker socket bind-mounted).
# A container with /var/run/docker.sock mounted gives that container host root — anything that
# compromises the daemon owns the machine, no escape needed. Running natively under systemd with the
# hardening below limits the daemon's own reach and removes the socket-in-a-container hole.
#
#   sudo useradd -r -G docker -d /opt/raven raven      # daemon user, in the docker group
#   sudo install -Dm600 contributor.env /etc/raven/contributor.env   # RAVEN_KEY, REGISTRY_URL, …
#   sudo cp contributor/systemd/raven-contributor.service /etc/systemd/system/
#   sudo systemctl enable --now raven-contributor
#
# Note: membership in the `docker` group is equivalent to root on this host — inherent to driving
# Docker. The gvisor/microvm tiers are what actually contain the *buyer*; this unit contains the
# *daemon*. For the strongest separation, run the microvm backend so the sandbox never shares your
# kernel, and keep this daemon on a machine you are willing to treat as dedicated.

[Unit]
Description=RAVEN contributor daemon
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=raven
Group=docker
WorkingDirectory=/opt/raven/contributor
EnvironmentFile=/etc/raven/contributor.env
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The daemon only needs to write its own tree and reach the Docker socket.
ReadWritePaths=/opt/raven /var/run/docker.sock

[Install]
WantedBy=multi-user.target
