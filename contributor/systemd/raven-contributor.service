# Run the contributor daemon natively instead of via `docker compose up contributor`. The daemon needs
# to reach the local Docker daemon to start each lease's sandbox container — that is host-root-
# equivalent either way, but running natively at least avoids bind-mounting the socket into a second
# container. This unit confines the *daemon*; Docker's flags confine the *buyer*.
#
#   sudo install -Dm600 contributor.env /etc/raven/contributor.env  # RAVEN_KEY, REGISTRY_URL, …
#   sudo cp contributor/systemd/raven-contributor.service /etc/systemd/system/
#   sudo systemctl enable --now raven-contributor

[Unit]
Description=RAVEN contributor daemon
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# Any user in the `docker` group works and is marginally safer than root — but note that group
# membership is already host-root-equivalent, so this is not a security boundary.
User=root
WorkingDirectory=/opt/raven/contributor
EnvironmentFile=/etc/raven/contributor.env
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=on-failure
RestartSec=5

# Hardening of the daemon process itself.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The daemon writes its own tree and talks to the Docker socket; nothing else.
ReadWritePaths=/opt/raven /var/run/docker.sock

[Install]
WantedBy=multi-user.target
