# Set these. Everything else has a code default — uncomment only to override.

# backend/registry — MongoDB (Atlas or any Mongo); custodial payout account; session-signing secret
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/raven?retryWrites=true&w=majority
PLATFORM_PAYTO=
PLATFORM_PRIVATE_KEY=            # base58 or JSON array. Server-only, payout signing. Unset = payouts recorded unpaid
SESSION_SECRET=                 # random 32+ byte string — signs the session JWTs

# web build — Privy app id (Solana enabled) baked in at build time
NEXT_PUBLIC_PRIVY_APP_ID=

# contributor daemon — the bearer key from the "Become a Contributor" page (no wallet, no payout env)
RAVEN_KEY=

# example buyer — its own funded devnet key (the autonomous agent; not the Privy web buyer)
BUYER_PRIVATE_KEY=

# Point the contributor + web build at the backend when it isn't on localhost
# REGISTRY_URL=http://your-host:4000
# NEXT_PUBLIC_REGISTRY_URL=http://your-host:4000

# Optional overrides (defaults shown)
# MONGODB_DB=raven                # database name (also settable in the URI path)
# PORT=4000
# SOLANA_RPC_URL=https://api.devnet.solana.com    # WS derived from this; buyer + contributor share it
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_CONTRIBUTOR_IMAGE=ghcr.io/your-org/raven-contributor
# METER_INTERVAL_MS=10000         # watchdog tick; worst-case over-use is one tick
# RATE_LAMPORTS_PER_HOUR=50000000 # 0.05 SOL/hour (contributor node)
# NODE_LABEL=                     # defaults to hostname
# SHARE_CPUS=                     # defaults to cores-1
# SHARE_MEM_MB=                   # defaults to half of RAM
# TUNNEL_MODE=bore                # bore = outbound tunnel, no inbound ports; local = same-LAN SSH
# BORE_SERVER=bore.pub
# BUYER_TOPUP_SOL=0.05
