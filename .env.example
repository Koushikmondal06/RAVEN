# ---------- backend / registry ----------
PORT=4000
# Neon (or any Postgres). Only money state lives here.
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/raven?sslmode=require
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Where every top-up lands (custodial pool).
PLATFORM_PAYTO=
# base58 or solana-keygen JSON array. Unset = payouts recorded as unpaid (txid null).
PLATFORM_PRIVATE_KEY=
# How often the watchdog asks "is this balance exhausted?" — worst-case over-use is one tick.
METER_INTERVAL_MS=10000

# ---------- contributor (each machine sharing compute) ----------
REGISTRY_URL=http://localhost:4000
# Your pubkey — earnings land here on lease end.
PAYOUT_ADDRESS=
RATE_LAMPORTS_PER_HOUR=50000000
NODE_LABEL=
SHARE_CPUS=
SHARE_MEM_MB=
# bore = outbound tunnel, no inbound ports. local = same-LAN SSH.
TUNNEL_MODE=bore
BORE_SERVER=bore.pub

# ---------- web (Next.js static export, baked in at build time) ----------
NEXT_PUBLIC_REGISTRY_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ---------- example buyer (autonomous agent) ----------
BUYER_PRIVATE_KEY=
BUYER_TOPUP_SOL=0.05
