# example buyer (autonomous agent — holds its own key, unlike the Privy-free web buyer).
BUYER_PRIVATE_KEY=              # its own funded devnet key (base58 or JSON array)
REGISTRY_URL=http://localhost:4000
MAINNET=false                   # true = mainnet-beta, false = devnet

# Optional overrides (defaults shown)
# BUYER_TOPUP_SOL=0.05
# SOLANA_RPC_URL=...             # overrides the MAINNET cluster RPC; WS derived from it
