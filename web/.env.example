# web (Next.js static export). NEXT_PUBLIC_* are baked in at build time.
# Local dev (`npm run web` + `npm run backend`): the registry's own URL.
# Docker / any https deployment: leave this as /api — the web image's nginx proxies /api/ to the
# backend, so the browser stays on one origin (a baked http:// URL is blocked as mixed content, and
# `localhost` in a static bundle means the *visitor's* machine).
NEXT_PUBLIC_REGISTRY_URL=http://localhost:4000
MAINNET=false                   # true = mainnet-beta, false = devnet (surfaced to the client build)

# Optional overrides (defaults shown)
# NEXT_PUBLIC_CONTRIBUTOR_IMAGE=ghcr.io/himanshum685/raven-contributor:sha-e51f5c3   # shown in the copy-paste run command; bump when you publish a new image
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
