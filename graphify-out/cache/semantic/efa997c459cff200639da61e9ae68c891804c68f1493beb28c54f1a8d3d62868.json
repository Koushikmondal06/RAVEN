{"nodes": [{"id": "docs_microvm_setup_kvm_requirement", "label": "microVM tier needs /dev/kvm", "file_type": "rationale", "source_file": "contributor/docs/microvm-setup.md", "source_location": "contributor/docs/microvm-setup.md:10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The microvm tier needs /dev/kvm \u2014 bare metal or a nested-virt-capable instance. Standard DigitalOcean droplets do not expose it (registry + MongoDB can still live on DO). Absent KVM, kata-fc/firecracker fail startup by design; fall back to gvisor."}, {"id": "docs_microvm_setup_ephemeral_rootfs", "label": "Ephemeral rootfs, no shared writable mounts", "file_type": "concept", "source_file": "contributor/docs/microvm-setup.md", "source_location": "contributor/docs/microvm-setup.md:38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each lease gets a guest kernel, cgroup v2 limits on the VMM, and an ephemeral read-only rootfs with noexec/nosuid tmpfs scratch \u2014 never a shared writable mount."}], "edges": [{"source": "docs_microvm_setup_kvm_requirement", "target": "sandbox_kata_fc_katafirecrackerbackend_probe", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "contributor/docs/microvm-setup.md", "source_location": "contributor/docs/microvm-setup.md:10", "weight": 1.0}, {"source": "docs_microvm_setup_kvm_requirement", "target": "sandbox_firecracker_firecrackerbackend_probe", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "contributor/docs/microvm-setup.md", "source_location": "contributor/docs/microvm-setup.md:10", "weight": 1.0}, {"source": "docs_microvm_setup_ephemeral_rootfs", "target": "sandbox_kata_fc_katafirecrackerbackend_create", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "contributor/docs/microvm-setup.md", "source_location": "contributor/docs/m